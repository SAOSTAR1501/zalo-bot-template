# ==========================================
# ZALO BOT PLATFORM CREDENTIALS
# ==========================================
# Get Bot Token from https://bot.zaloplatforms.com
ZALO_BOT_TOKEN=your_bot_id:your_bot_token_here

# Secret token used for Webhook validation (set via setWebhook API)
ZALO_WEBHOOK_SECRET=your_custom_secret_token_here

# Public Webhook URL (must be HTTPS, e.g. through Cloudflare Tunnel or domain)
WEBHOOK_URL=https://your-bot-domain.com/webhook

# ==========================================
# AI / LLM PROVIDER CONFIGURATION
# ==========================================
# AI Provider: ollama | gemini | openai | deepseek | echo
AI_PROVIDER=ollama

# --- 1. OLLAMA (Cloud or Local) ---
# Ollama Cloud: https://ollama.com (Get API key at https://ollama.com/settings/keys)
# Ollama Local: http://localhost:11434 (Leave API key empty)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_MODEL=gemma4:31b

# --- 2. GOOGLE GEMINI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- 3. OPENAI / DEEPSEEK / COMPATIBLE ---
OPENAI_API_KEY=your_openai_or_deepseek_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# BOT MEMORY & CONTEXT CONFIGURATION (EPISODIC MEMORY)
# ==========================================
# Rolling context time window in hours (default: 12 hours)
MAX_CONTEXT_HOURS=12

# Number of recent raw messages to retain verbatim in LLM prompt (default: 4)
RECENT_MESSAGES_COUNT=4

# Threshold of unsummarized messages before auto-rollup into episodic summary (default: 6)
AUTO_SUMMARIZE_THRESHOLD=6

# SQLite database file path
DB_PATH=data/zalo_bot.db

# ==========================================
# ACCESS CONTROL & PERMISSIONS (OPTIONAL)
# ==========================================
# Comma-separated list of Admin user IDs (e.g. 3f6de3efa9a340fd19b2,...)
ADMIN_USER_IDS=

# Comma-separated list of Allowed group IDs (leave empty to allow all groups)
ALLOWED_GROUP_IDS=

# Server Port
PORT=8080
HOST=0.0.0.0
